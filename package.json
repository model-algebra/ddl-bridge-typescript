{
  "name": "ddl-bridge-typescript",
  "description": "Converts model-algebra models to PostgreSQL DDL and back, and migrates databases to models",
  "version": "0.1.0",
  "private": false,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "keywords": [
    "model-algebra",
    "ddl",
    "postgresql",
    "migration",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "packageManager": "pnpm@10.27.0",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "tsc -p tsconfig.build.json",
    "type-check": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/pg": "8.18.0",
    "pg": "8.23.1",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  },
  "dependencies": {
    "libpg-query": "18.1.5",
    "model-algebra-common": "github:model-algebra/common-typescript",
    "model-algebra-typescript": "github:model-algebra/model-algebra-typescript"
  }
}
